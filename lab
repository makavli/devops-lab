#!/usr/bin/env bash
# lab: the one entry point for this repo. Every command is idempotent: run it again to converge.
# Handbooks: docs/handbook/. Usage: ./lab <command>
set -euo pipefail
cd "$(dirname "$0")"
export PATH="$HOME/.local/bin:$PATH"

CLUSTER=lab
# Pinned platform versions: bump one, run ./lab up, check, commit (docs/handbook/06-ci.md).
METALLB_VERSION=0.16.2
ENVOY_GATEWAY_VERSION=1.10.0
KPS_VERSION=93.3.0          # kube-prometheus-stack
ARGOCD_VERSION=10.18.0      # argo-cd chart (Argo CD v3.6)

log() { printf '\n\033[1;34m==> %s\033[0m\n' "$*"; }
# retry N cmd...: admission webhooks answer a few seconds after their Deployment is Ready
retry() { local n=$1; shift; until "$@"; do ((--n)) || return 1; sleep 5; done; }
repo() { gh repo view --json nameWithOwner -q .nameWithOwner; }

## up        create the cluster if missing, install/upgrade the whole platform, deploy apps
cmd_up() {
  kind get clusters 2>/dev/null | grep -qx "$CLUSTER" || kind create cluster --config cluster/kind.yaml
  kubectl config use-context "kind-$CLUSTER" >/dev/null

  log "MetalLB $METALLB_VERSION"
  helm upgrade --install metallb metallb --repo https://metallb.github.io/metallb --version "$METALLB_VERSION" \
    -n metallb-system --create-namespace --wait
  retry 12 kubectl apply -f platform/metallb/pool.yaml

  log "Envoy Gateway $ENVOY_GATEWAY_VERSION"
  helm upgrade --install eg oci://docker.io/envoyproxy/gateway-helm --version "$ENVOY_GATEWAY_VERSION" \
    -n envoy-gateway-system --create-namespace --wait
  kubectl apply -f platform/envoy-gateway/gateway.yaml
  kubectl wait gateway/lab --for=condition=Programmed --timeout=180s

  log "kube-prometheus-stack $KPS_VERSION"
  helm upgrade --install kps kube-prometheus-stack --repo https://prometheus-community.github.io/helm-charts \
    --version "$KPS_VERSION" -n monitoring --create-namespace -f platform/monitoring/values.yaml --wait --timeout 10m
  kubectl apply -f platform/monitoring/routes.yaml

  log "Argo CD (chart $ARGOCD_VERSION)"
  helm upgrade --install argocd argo-cd --repo https://argoproj.github.io/argo-helm --version "$ARGOCD_VERSION" \
    -n argocd --create-namespace -f platform/argocd/values.yaml --wait --timeout 10m
  kubectl apply -f platform/argocd/route.yaml

  # Once GitOps is on, Argo CD owns apps/: applying them by hand would only fight its self-heal.
  if kubectl -n argocd get application apps >/dev/null 2>&1; then
    log "apps/ is delivered by Argo CD (root app present)"
  else
    log "apps (direct apply; ./lab gitops hands them to Argo CD)"
    kubectl apply -R -f apps/
  fi
  cmd_status
}

## stop      end of day: stop the node containers cleanly (state kept), then run `wsl --shutdown` on Windows
cmd_stop() {
  local cp workers
  cp=$(kind get nodes --name "$CLUSTER" | grep control-plane)
  mapfile -t workers < <(kind get nodes --name "$CLUSTER" | grep -v control-plane)
  # kind sets --restart=on-failure:1, and a daemon restart (any WSL boot) ignores the manual stop:
  # the SIGKILLed control plane (exit 137) and its workers would come back on their own. Park them.
  docker update --restart=no "$cp" "${workers[@]}" >/dev/null
  # Workers first, control plane last: kubelets stop while the API server still answers.
  docker stop -t 60 "${workers[@]}" >/dev/null   # workers shut down cleanly within seconds
  # shortcut: the control plane never finishes its systemd shutdown, even with 60 s (exit 137 = SIGKILL);
  # etcd is crash-consistent (WAL + fsync), so this equals a power cut it survives. Upgrade: find the hanging unit.
  docker stop -t 30 "$cp" >/dev/null
  docker ps -a --filter "label=io.x-k8s.kind.cluster=$CLUSTER" --format '{{.Names}}: {{.Status}}'
}

## start     start the stopped cluster, wait until traffic flows end to end
cmd_start() {
  local cp workers
  cp=$(kind get nodes --name "$CLUSTER" | grep control-plane)
  mapfile -t workers < <(kind get nodes --name "$CLUSTER" | grep -v control-plane)
  docker start "$cp" >/dev/null
  docker start "${workers[@]}" >/dev/null
  docker update --restart=on-failure:1 "$cp" "${workers[@]}" >/dev/null   # kind default: self-heal by day
  kubectl config use-context "kind-$CLUSTER" >/dev/null
  retry 36 kubectl get --raw /readyz >/dev/null 2>&1   # API server back (up to 3 min)
  # Ready/Programmed/Healthy conditions are stale right after a restart (they still say what was true
  # before the stop), so the real readiness test is a request through the whole path.
  log "waiting for traffic through the Gateway"
  retry 60 curl -sf -o /dev/null http://echo.localtest.me/hostname
  cmd_status
}

## turnoff   end of day in one go: ./lab stop, then shut down WSL itself (closes this terminal, frees the RAM)
cmd_turnoff() {
  if kind get clusters 2>/dev/null | grep -qx "$CLUSTER"; then cmd_stop; fi
  log "shutting down WSL: this terminal closes. Tomorrow: ./lab start"
  wsl.exe --shutdown   # Windows interop: the same as running it from PowerShell
}

## down      delete the cluster (everything in it is rebuilt by ./lab up)
cmd_down() { kind delete cluster --name "$CLUSTER"; }

## status    nodes, gateway, routes, unhealthy pods, Argo CD apps, URLs
cmd_status() {
  log nodes; kubectl get nodes
  log gateway; kubectl get gateway -A
  log routes; kubectl get httproute -A -o custom-columns='NAMESPACE:.metadata.namespace,NAME:.metadata.name,HOSTS:.spec.hostnames'
  log "pods not Running/Succeeded"
  kubectl get pods -A --field-selector=status.phase!=Running,status.phase!=Succeeded --no-headers 2>/dev/null || true
  log "Argo CD applications"; kubectl -n argocd get applications 2>/dev/null || echo "(none yet: ./lab gitops)"
  log URLs
  printf '  %s\n' http://echo.localtest.me/hostname http://grafana.localtest.me http://prometheus.localtest.me \
    http://alertmanager.localtest.me http://argocd.localtest.me "(logins: ./lab passwords)"
}

## passwords print the Grafana and Argo CD admin passwords
cmd_passwords() {
  printf 'grafana  admin / %s\n' "$(kubectl -n monitoring get secret kps-grafana -o jsonpath='{.data.admin-password}' | base64 -d)"
  printf 'argocd   admin / %s\n' "$(kubectl -n argocd get secret argocd-initial-admin-secret -o jsonpath='{.data.password}' | base64 -d)"
}

## gitops    give Argo CD a fresh read-only deploy key, then apply the root app (needs gh auth + pushed repo)
cmd_gitops() {
  local r url tmp id
  r=$(repo); url="git@github.com:$r.git"
  tmp=$(mktemp -d); trap 'rm -rf "$tmp"' RETURN   # the private key never stays on disk outside the cluster
  ssh-keygen -q -t ed25519 -N "" -C "argocd@devops-lab" -f "$tmp/key"
  for id in $(gh api "repos/$r/keys" -q '.[] | select(.title=="argocd-lab") | .id'); do
    gh api -X DELETE "repos/$r/keys/$id"            # rotate: one live deploy key at a time
  done
  gh repo deploy-key add "$tmp/key.pub" --title argocd-lab   # read-only unless --allow-write
  kubectl -n argocd create secret generic repo-devops-lab --from-literal=type=git --from-literal=url="$url" \
    --from-file=sshPrivateKey="$tmp/key" --dry-run=client -o yaml \
    | kubectl label --local -f - argocd.argoproj.io/secret-type=repository -o yaml | kubectl apply -f -
  sed "s#repoURL: .*#repoURL: $url#" gitops/root.yaml | kubectl apply -f -
  kubectl -n argocd get applications
}

## check     validate the shell script and every manifest against its schema (CI runs this too)
cmd_check() {
  command -v kubeconform >/dev/null || cmd_tools
  bash -n lab
  if command -v shellcheck >/dev/null; then shellcheck lab; else echo "shellcheck not installed: skipped"; fi
  # Zero cost: this private repo's CI runs only on our self-hosted runner, never on GitHub-hosted minutes.
  if grep -rnE '^\s*runs-on:' .github/workflows | grep -v 'self-hosted'; then
    echo "check: the runs-on lines above use GitHub-hosted runners; use [self-hosted, linux, devops-lab]" >&2
    return 1
  fi
  find apps platform gitops -name '*.yaml' ! -name values.yaml -print0 | xargs -0 kubeconform -strict -summary \
    -schema-location default \
    -schema-location 'https://raw.githubusercontent.com/datreeio/CRDs-catalog/main/{{.Group}}/{{.ResourceKind}}_{{.ResourceAPIVersion}}.json'
}

## tools     install kubeconform and k9s into ~/.local/bin (no sudo)
cmd_tools() {
  mkdir -p ~/.local/bin
  curl -fsSL https://github.com/yannh/kubeconform/releases/latest/download/kubeconform-linux-amd64.tar.gz | tar xz -C ~/.local/bin kubeconform
  curl -fsSL https://github.com/derailed/k9s/releases/latest/download/k9s_Linux_amd64.tar.gz | tar xz -C ~/.local/bin k9s
  kubeconform -v; k9s version --short
}

## runner    install this WSL box as the repo's self-hosted GitHub Actions runner (systemd service)
cmd_runner() {
  local r dir=~/actions-runner v tok
  r=$(repo)
  if [ ! -x "$dir/run.sh" ]; then
    v=$(gh api repos/actions/runner/releases/latest -q .tag_name); v=${v#v}
    mkdir -p "$dir"
    curl -fsSL "https://github.com/actions/runner/releases/download/v$v/actions-runner-linux-x64-$v.tar.gz" | tar xz -C "$dir"
    sudo "$dir/bin/installdependencies.sh"
  fi
  tok=$(gh api -X POST "repos/$r/actions/runners/registration-token" -q .token)   # single-use, expires in 1h
  (cd "$dir" && ./config.sh --unattended --replace --url "https://github.com/$r" --token "$tok" \
    --name "$(hostname)-wsl" --labels devops-lab)
  (cd "$dir" && { sudo ./svc.sh status >/dev/null 2>&1 || sudo ./svc.sh install "$USER"; } && sudo ./svc.sh start)
}

## help      this list
cmd_help() { grep '^## ' "$0" | cut -c4-; }

"cmd_${1:-help}" "${@:2}"
